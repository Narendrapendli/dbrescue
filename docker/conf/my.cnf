# ==============================================================================
# MySQL 8.4 LTS Server Hardened Configuration (dbrescue)
# ==============================================================================

[mysqld]
# Networking & Protocol
bind-address            = 0.0.0.0
port                    = 3306
max_connections         = 100
connect_timeout         = 10
wait_timeout            = 600
interactive_timeout     = 600

# Character Set & Collation (Modern UTF8mb4 standard)
character-set-server    = utf8mb4
collation-server        = utf8mb4_0900_ai_ci

# Storage Engine & InnoDB Tuning
default-storage-engine  = InnoDB
innodb_file_per_table   = 1
innodb_buffer_pool_size = 512M
innodb_log_buffer_size  = 16M
innodb_flush_log_at_trx_commit = 1
innodb_flush_method     = O_DIRECT
innodb_stats_on_metadata = 0

# Redo Logs & Checkpointing
innodb_redo_log_capacity = 100M

# Crash Recovery Defaults (0 = normal, 1-6 = force recovery if activated)
innodb_force_recovery   = 0

# Security & Permissions
local_infile            = 0
skip-name-resolve       = 1
default_authentication_plugin = caching_sha2_password

# Logging & Forensics
log_error_verbosity     = 3
slow_query_log          = 1
long_query_time         = 2.0
log_timestamps          = UTC

[client]
default-character-set   = utf8mb4

[mysql]
default-character-set   = utf8mb4
