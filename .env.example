# ==============================================================================
# dbrescue Environment Configuration Template
# NOTE: Copy this file to .env and configure with secure values.
# DO NOT commit real passwords or secrets to source control.
# ==============================================================================

# Application Environment & Logging
DBRESCUE_ENV=development
DBRESCUE_LOG_LEVEL=INFO
DBRESCUE_SQLITE_PATH=./db/sqlite/operational.db
DBRESCUE_BACKUP_DIR=./backups
DBRESCUE_REPORTS_DIR=./docs/reports

# Primary MySQL 8.4 Instance (MUST bind to loopback 127.0.0.1)
MYSQL_PRIMARY_HOST=127.0.0.1
MYSQL_PRIMARY_PORT=3306
MYSQL_DATABASE=rescue_ecommerce
MYSQL_USER=rescue_user
MYSQL_PASSWORD=CHANGE_ME_PRIMARY_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD

# Isolated Rescue Sandbox MySQL 8.4 Instance (MUST bind to loopback 127.0.0.1)
MYSQL_SANDBOX_HOST=127.0.0.1
MYSQL_SANDBOX_PORT=3307

# Docker Infrastructure Identifiers
DOCKER_PRIMARY_CONTAINER=dbrescue-mysql-primary
DOCKER_SANDBOX_CONTAINER=dbrescue-mysql-sandbox
DOCKER_TARGET_VOLUME=dbrescue_mysql_data

# Observability & Dashboard Ports
PROMETHEUS_METRICS_PORT=9108
STREAMLIT_SERVER_PORT=8501

# Operational Safety Bounds & Thresholds
BACKUP_RETENTION_DAYS=30
MAX_DATASET_SIZE_MB=10240
SANDBOX_TIMEOUT_SEC=60
MAX_ALLOWED_ROW_DISCREPANCY=0
